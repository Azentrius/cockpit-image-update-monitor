[Unit]
Description=Versions-Radar for Image Update Monitor (registry tag check)
Documentation=file:///usr/lib/cockpit-image-updates/diun-versions.py
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/lib/cockpit-image-updates/diun-versions.py --output /var/lib/diun-radar/versions.json
# Creates /var/lib/diun-radar (root-owned, NOT mounted into any container).
StateDirectory=diun-radar
StateDirectoryMode=0755
Nice=10
TimeoutStartSec=15min

# Hardening: the job only reads Docker and talks to registries.
# No NoNewPrivileges=: on the RHEL rebuilds it keeps the docker command out of
# its SELinux domain (container_runtime_t), and every call is a denial in the
# audit log. The job runs as root; what the settings below take away, no exec
# gives back without it either.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

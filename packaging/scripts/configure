# shellcheck shell=sh
# After every install and upgrade of cockpit-image-update-monitor (as root; also `make install`).
# SPDX-License-Identifier: Apache-2.0
#
# Up to 0.11, install.sh put the page into /usr/share/cockpit/diun, the helpers into
# /usr/local/lib/diun-radar and copies of the units into /etc/systemd/system. Those copies would
# hide the units of the package, so they go, and so do the old page and helpers. Backups that
# install.sh made (/usr/local/lib/diun-radar/backup-*) and all data stay.
old=/usr/local/lib/diun-radar
for unit in diun-radar.service diun-radar.timer diun-cleanup.service diun-cleanup.timer; do
    copy=/etc/systemd/system/$unit
    [ -f "$copy" ] || continue
    # A copy that runs the old helpers would fail; a copy that is the same as the package's unit
    # (the timers have no path in them) adds nothing and would hide its later changes. A timer
    # copy changed by hand stays: it only names its service and keeps working as an override.
    if grep -q "$old/" "$copy" || cmp -s "$copy" "/usr/lib/systemd/system/$unit"; then
        rm -f "$copy"
    fi
done
if [ -f /usr/share/cockpit/diun/diun.js ]; then
    rm -rf /usr/share/cockpit/diun
fi
if [ -d "$old" ]; then
    rm -rf "${old:?}/systemd" "${old:?}/__pycache__"
    for f in diun-inventory.py diun-versions.py diun-update.py diun-deps.sh diunlib.py; do
        rm -f "${old:?}/$f"
    done
    rmdir "$old" 2> /dev/null || true
fi
if [ -d /run/systemd/system ]; then
    systemctl daemon-reload || true
    for timer in diun-radar.timer diun-cleanup.timer; do
        # A timer that was on stays on, now from the unit of the package (daemon-reload reads it).
        # It is started only when it does not run: (re)starting a timer whose OnBootSec= lies in
        # the past starts its service at once, in the middle of this apt run.
        if [ -L "/etc/systemd/system/timers.target.wants/$timer" ]; then
            systemctl reenable "$timer" > /dev/null 2>&1 || true
            systemctl is-active --quiet "$timer" || systemctl start "$timer" || true
        fi
    done
    # A new version may change the format of the radar's data: refresh it, two minutes from now.
    # The same apt run can restart systemd-resolved or the network, and a run in that moment
    # reaches no registry (build-host, 2026-10-20). Without systemd-run: at once, as before.
    if systemctl is-enabled --quiet diun-radar.timer 2> /dev/null \
        && ! systemctl is-active --quiet diun-radar-after-install.timer; then
        systemd-run --quiet --unit=diun-radar-after-install --on-active=120 --timer-property=AccuracySec=10s \
            "$(command -v systemctl)" start --no-block diun-radar.service 2> /dev/null \
            || systemctl start --no-block diun-radar.service || true
    fi
fi
